# ============================================================
# CARA KERJA KONFIGURASI
# ============================================================

# Nilai dibaca dari environment container (docker-compose `environment:` /
# `env_file:`), dari file .env (di working directory atau CONFIG_DIR/.env),
# lalu dari tabel `settings` di database.
#
# Saat start, setiap variabel di file ini yang terisi (tidak kosong) disimpan
# ke tabel settings; nilai rahasia (token, hash, session, secret) disimpan
# terenkripsi dengan ENCRYPTION_KEY. Jadi setelah start pertama, .env boleh
# dikurangi sampai hanya berisi DB_DRIVER (+ DATABASE_URL untuk postgres),
# ENCRYPTION_KEY dan login dashboard (WEB_DASHBOARD_TOKEN atau OIDC_*);
# sisanya diambil dari database dan bisa diubah di halaman Settings dashboard.
#
# Urutan prioritas: environment / .env (jika tidak kosong) > tabel settings > default.
# Nilai berawalan "enc:" didekripsi dengan ENCRYPTION_KEY.


# ============================================================
# DATABASE (wajib lewat environment / .env, tidak pernah disimpan di database)
# ============================================================

# Driver database: sqlite (default) atau postgres
# DB_DRIVER=sqlite

# postgres: connection string, wajib jika DB_DRIVER=postgres
#   postgres://user:password@host:port/database?sslmode=disable
# sqlite: path file database (opsional), default CONFIG_DIR/zee-mirror.db
# DATABASE_URL=

# Kunci AES-256 (64 karakter hex), wajib. Mengenkripsi nilai rahasia di tabel
# settings (token, rclone config, cookies, session...) dan menandatangani sesi
# dashboard. Buat dengan: openssl rand -hex 32
ENCRYPTION_KEY=

# Direktori config di dalam container (database sqlite, rclone.conf, cookies).
# Jangan diubah kecuali perlu.
# CONFIG_DIR=/app/config


# ============================================================
# BOT
# ============================================================

# Token Bot Telegram dari @BotFather
# Untuk single bot, gunakan BOT_TOKEN
BOT_TOKEN=

# Untuk multi-bot, gunakan BOT_TOKENS
# Pisahkan dengan koma
# BOT_TOKENS=bot1_token,bot2_token,bot3_token

# User ID Telegram pemilik bot
OWNER_ID=


# ============================================================
# SECRETS (rclone.conf & cookies.txt)
# ============================================================

# rclone.conf dan cookies.txt disimpan di tabel settings (RCLONE_CONFIG,
# COOKIES) dan hanya di-mount ke RAM (tmpfs). CONFIG_DIR/rclone.conf dan
# cookies.txt menjadi symlink ke RAM. Token rclone / cookie yang diperbarui
# otomatis disimpan kembali ke database.
# File biasa yang diletakkan di CONFIG_DIR akan di-import saat start lalu dihapus.
# Harus berupa tmpfs/ramfs di Linux, bot menolak start jika bukan.
SECRETS_DIR=/dev/shm

# Opsional: folder read-only (mis. Secret k8s) berisi rclone.conf / cookies.txt
# yang hanya dipakai jika database belum punya nilai. Tidak pernah dihapus.
# SECRETS_SEED_DIR=

# Secret RPC aria2 (opsional, disarankan). Dipakai oleh daemon aria2c dan bot.
# Buat dengan: openssl rand -hex 32
# ARIA2_RPC_SECRET=


# ============================================================
# DASHBOARD & NETWORKING
# ============================================================

# Port luar yang diakses lewat browser
DASHBOARD_PORT=80

# Port internal container
# Direkomendasikan tetap 5248
# DASHBOARD_PORT_INTERNAL=5248

# URL publik dashboard
# Contoh:
# http://localhost
# http://your-ip-or-domain
# https://your-domain.com
WEB_DASHBOARD_URL=http://your-ip-or-domain

# Login dashboard: wajib salah satu (atau keduanya).
#
# 1) Token statis, minimal 16 karakter. Buat dengan: openssl rand -hex 24
# WEB_DASHBOARD_TOKEN=
#
# 2) OpenID Connect (mis. Pocket-ID), authorization code + PKCE.
# Daftarkan callback URL berikut di provider:
#   <WEB_DASHBOARD_URL>/api/auth/oidc/callback
# Hanya anggota grup di OIDC_ALLOWED_GROUPS yang boleh masuk (claim "groups";
# scope "groups" diminta otomatis).
# OIDC_ISSUER=https://pocketid.example.com
# OIDC_CLIENT_ID=
# Kosongkan untuk public client (PKCE saja)
# OIDC_CLIENT_SECRET=
# Opsional, default <WEB_DASHBOARD_URL>/api/auth/oidc/callback
# OIDC_REDIRECT_URL=
# Wajib untuk OIDC: hanya anggota grup ini yang boleh login (pisahkan dengan koma).
# OIDC_ALLOWED_GROUPS=zee-admin
# OIDC_PROVIDER_NAME=Pocket-ID
#
# ENCRYPTION_KEY juga dipakai untuk menandatangani sesi (sesi tetap valid
# setelah restart). Mengganti WEB_DASHBOARD_TOKEN mengakhiri sesi token lama.


# ============================================================
# STORAGE & DOWNLOAD
# ============================================================

# Tujuan default rclone
# Format: remote:path
RCLONE_DEST=gdrive:/Zee-Mirror

# Optional: Index URL untuk Google Drive
# Contoh:
# https://your-index.workers.dev
INDEX_URL=

# Direktori download di dalam container
# Jangan diubah kecuali perlu
# DOWNLOAD_DIR=/app/downloads


# ============================================================
# BOT SETTINGS
# ============================================================

# User ID tambahan yang diizinkan selain owner
# Pisahkan dengan koma
# Contoh:
# 123456789,987654321
AUTHORIZED_USERS=

# Group/topic yang semua anggotanya boleh memakai bot (seperti MLTB)
# Pisahkan dengan koma atau spasi
#   chatID        -> seluruh group, perintah harus menyebut bot: /mirror@NamaBot
#   chatID:topic  -> topic tsb, tanpa perlu menyebut bot; balasan bot dikirim ke sini
# Contoh:
# -1003205657826 -1003205657826:6231
AUTHORIZED_CHATS=

# Batas download bersamaan
MAX_CONCURRENT_DOWNLOADS=3

# Mencegah download file yang sama secara bersamaan
STOP_DUPLICATE=false

# Batas task harian per user
# -1 = tanpa batas
DEFAULT_MAX_DAILY_TASKS=-1

# Batas bandwidth harian per user
# Contoh: 10GB
# -1 = tanpa batas
DEFAULT_MAX_DAILY_BANDWIDTH=-1

# Otomatis mengorganisir file berdasarkan kategori
SMART_AUTO_ORGANIZATION=false


# ============================================================
# LOGGING & DEBUG
# ============================================================

# Level: debug, info, warn, error
LOG_LEVEL=info

# Format: text atau json
LOG_FORMAT=text

# Optional Sentry DSN
# Kosongkan jika tidak menggunakan Sentry
SENTRY_DSN=

# Environment aplikasi
# Contoh: development, staging, production
APP_ENV=production

# Release version aplikasi (hanya dari environment, tidak disimpan di database)
# APP_RELEASE=

# Zona waktu sistem
TZ=Asia/Jakarta


# ============================================================
# WEBHOOK MODE
# ============================================================

# false = long polling
# true  = webhook mode
# Webhook membutuhkan HTTPS publik
USE_WEBHOOK=false

# URL publik server
# Wajib jika USE_WEBHOOK=true
# Contoh:
# https://your-domain.com
WEBHOOK_URL=

# Secret token untuk verifikasi webhook Telegram
WEBHOOK_SECRET=


# ============================================================
# TELEGRAM BOT API
# ============================================================

# api_id / api_hash dari https://my.telegram.org
# Dipakai oleh userbot dan oleh Local Bot API server (telegram-bot-api) yang
# sudah dibundel di image dan dijalankan otomatis oleh bot.
APP_ID=
APP_HASH=

# Jalankan Local Bot API bawaan (untuk file besar). Default: true
# LOCAL_BOT_API=true

# Endpoint Bot API eksternal. Jika diisi, Local Bot API bawaan tidak dijalankan.
# TELEGRAM_API=http://telegram-bot-api:8081/bot%s/%s


# ============================================================
# USERBOT CONFIGURATION
# ============================================================

# Optional
# Diperlukan untuk akses private channel/group
# Generate dengan:
# go run cmd/session-gen/main.go
USER_SESSION_STRING=

# Timeout (detik) untuk getFile di local Telegram Bot API
# Local API mengunduh seluruh file dari CDN Telegram sebelum menjawab getFile,
# jadi file besar butuh waktu menit. Default: 600
TG_GETFILE_TIMEOUT=600


# ============================================================
# VIKING FILE CONFIGURATION
# ============================================================

# Optional
# Kosongkan untuk anonymous upload
VIKING_USER_HASH=


# ============================================================
# MAINTENANCE
# ============================================================

# Batas hari sebelum history task dibersihkan dari database
AUTO_CLEANUP_DAYS=30