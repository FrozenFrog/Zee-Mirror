# ============================================================
# DATABASE (satu-satunya yang wajib lewat environment)
# ============================================================

# docker-compose hanya meneruskan DATABASE_URL dan ENCRYPTION_KEY ke container.
# Semua key lain di file ini boleh disimpan sebagai baris di tabel `settings`
# (kolom key = nama variabel, mis. BOT_TOKEN, OWNER_ID, RCLONE_DEST).
# Urutan prioritas: environment (jika tidak kosong) > tabel settings > default.
# Nilai berawalan "enc:" didekripsi dengan ENCRYPTION_KEY.

# PostgreSQL connection string
# Format: postgres://user:password@host:port/database?sslmode=disable
# Untuk sqlite: DB_DRIVER=sqlite dan DATABASE_URL=/app/data/zee-mirror.db
DATABASE_URL=

# Driver database: postgres (default) atau sqlite
# DB_DRIVER=postgres


# ============================================================
# BOT (bisa disimpan di tabel settings)
# ============================================================

# Token Bot Telegram dari @BotFather
# Untuk single bot, gunakan BOT_TOKEN
# BOT_TOKEN=your_bot_token_here

# Untuk multi-bot, gunakan BOT_TOKENS
# Pisahkan dengan koma
# BOT_TOKENS=bot1_token,bot2_token,bot3_token

# User ID Telegram pemilik bot
# OWNER_ID=your_telegram_user_id


# ============================================================
# SECRETS (rclone.conf & cookies.txt)
# ============================================================

# rclone.conf dan cookies.txt disimpan di tabel settings dan hanya
# di-mount ke RAM (tmpfs). CONFIG_DIR/rclone.conf dan cookies.txt menjadi
# symlink ke RAM. Token rclone / cookie yang diperbarui otomatis disimpan
# kembali ke database.
# File biasa yang diletakkan di CONFIG_DIR akan di-import saat start lalu dihapus.
# Harus berupa tmpfs/ramfs di Linux, bot menolak start jika bukan.
SECRETS_DIR=/dev/shm

# Opsional: folder read-only (mis. Secret k8s) berisi rclone.conf / cookies.txt
# yang hanya dipakai jika database belum punya nilai. Tidak pernah dihapus.
# SECRETS_SEED_DIR=

# Kunci AES-256 (64 karakter hex) untuk mengenkripsi nilai di tabel settings
# (rclone config, cookies, token, session...). Selalu dari environment, tidak
# pernah disimpan di database. Buat dengan: openssl rand -hex 32
# ENCRYPTION_KEY=


# ============================================================
# REDIS CACHE / QUEUE
# ============================================================

# Redis connection URL
# Kosongkan untuk menonaktifkan Redis
# Format:
# redis://username:password@host:port/db
# Contoh:
# redis://localhost:6379/0
REDIS_URL=


# ============================================================
# DASHBOARD & NETWORKING
# ============================================================

# Port luar yang diakses lewat browser
DASHBOARD_PORT=80

# Port internal container
# Direkomendasikan tetap 5248
# DASHBOARD_PORT_INTERNAL=5248

# URL publik dashboard
# Contoh:
# http://localhost
# http://your-ip-or-domain
# https://your-domain.com
WEB_DASHBOARD_URL=http://your-ip-or-domain

# Token/password untuk login dashboard
WEB_DASHBOARD_TOKEN=zee-mirror-secret


# ============================================================
# STORAGE & DOWNLOAD
# ============================================================

# Tujuan default rclone
# Format: remote:path
RCLONE_DEST=gdrive:/Zee-Mirror

# Optional: Index URL untuk Google Drive
# Contoh:
# https://your-index.workers.dev
INDEX_URL=

# Direktori internal container
# Jangan diubah kecuali perlu
DOWNLOAD_DIR=/app/downloads
CONFIG_DIR=/app/config


# ============================================================
# BOT SETTINGS
# ============================================================

# User ID tambahan yang diizinkan selain owner
# Pisahkan dengan koma
# Contoh:
# 123456789,987654321
AUTHORIZED_USERS=

# Group/topic yang semua anggotanya boleh memakai bot (seperti MLTB)
# Pisahkan dengan koma atau spasi
#   chatID        -> seluruh group, perintah harus menyebut bot: /mirror@NamaBot
#   chatID:topic  -> topic tsb, tanpa perlu menyebut bot; balasan bot dikirim ke sini
# Contoh:
# -1003205657826 -1003205657826:6231
AUTHORIZED_CHATS=

# Batas download bersamaan
MAX_CONCURRENT_DOWNLOADS=3

# Mencegah download file yang sama secara bersamaan
STOP_DUPLICATE=false

# Batas task harian per user
# -1 = tanpa batas
DEFAULT_MAX_DAILY_TASKS=-1

# Batas bandwidth harian per user
# Contoh: 10GB
# -1 = tanpa batas
DEFAULT_MAX_DAILY_BANDWIDTH=-1

# Otomatis mengorganisir file berdasarkan kategori
SMART_AUTO_ORGANIZATION=false


# ============================================================
# LOGGING & DEBUG
# ============================================================

# Level: debug, info, warn, error
LOG_LEVEL=info

# Format: text atau json
LOG_FORMAT=text

# Optional Sentry DSN
# Kosongkan jika tidak menggunakan Sentry
SENTRY_DSN=

# Environment aplikasi
# Contoh: development, staging, production
APP_ENV=production

# Release version aplikasi
APP_RELEASE=

# Zona waktu sistem
TZ=Asia/Jakarta


# ============================================================
# WEBHOOK MODE
# ============================================================

# false = long polling
# true  = webhook mode
# Webhook membutuhkan HTTPS publik
USE_WEBHOOK=false

# URL publik server
# Wajib jika USE_WEBHOOK=true
# Contoh:
# https://your-domain.com
WEBHOOK_URL=

# Secret token untuk verifikasi webhook Telegram
WEBHOOK_SECRET=


# ============================================================
# TELEGRAM BOT API
# ============================================================

# api_id / api_hash dari https://my.telegram.org
# Dipakai oleh userbot dan oleh Local Bot API server (telegram-bot-api) yang
# sudah dibundel di image dan dijalankan otomatis oleh bot.
APP_ID=
APP_HASH=

# Jalankan Local Bot API bawaan (untuk file besar). Default: true
# LOCAL_BOT_API=true

# Endpoint Bot API eksternal. Jika diisi, Local Bot API bawaan tidak dijalankan.
# TELEGRAM_API=http://telegram-bot-api:8081/bot%s/%s


# ============================================================
# USERBOT CONFIGURATION
# ============================================================

# Optional
# Diperlukan untuk akses private channel/group
# Generate dengan:
# go run cmd/session-gen/main.go
USER_SESSION_STRING=

# Timeout (detik) untuk getFile di local Telegram Bot API
# Local API mengunduh seluruh file dari CDN Telegram sebelum menjawab getFile,
# jadi file besar butuh waktu menit. Default: 600
TG_GETFILE_TIMEOUT=600


# ============================================================
# VIKING FILE CONFIGURATION
# ============================================================

# Optional
# Kosongkan untuk anonymous upload
VIKING_USER_HASH=


# ============================================================
# MAINTENANCE
# ============================================================

# Batas hari sebelum history task dibersihkan dari database
AUTO_CLEANUP_DAYS=30